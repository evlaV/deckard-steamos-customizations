[system]
compatible=@rauc_compatible@
bootloader=custom
max-bundle-download-size=268435456
activate-installed=false

[keyring]
path=/etc/rauc/keyring.pem

[casync]
tmppath=/tmp
install-args=--seed /var/lib/steamos-atomupd/rootfs.caibx --config /etc/desync/config.json --in-place --error-retry 35 --regenerate-invalid-seeds
use-desync=true

[handlers]
bootloader-custom-backend=@libdir@/rauc/bootloader-custom-backend.sh
pre-install=@libdir@/rauc/pre-install.sh
post-install=@libdir@/rauc/post-install.sh

[slot.rootfs.0]
bootname=A
device=@udev_symlinks_absdir@/A/rootfs
type=raw

[slot.rootfs.1]
bootname=B
device=@udev_symlinks_absdir@/B/rootfs
type=raw
