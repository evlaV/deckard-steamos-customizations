set -euo pipefail

function usage
{
    cat <<EOF
Usage: ${0##*/} [--roothash=HASH] [--no-bootloaders] [--no-kernel] [--no-migrate]

Perform post-update migration steps before marking the new installation ready.
Install boot artifacts on your device.
EOF
}

# Install boot artifacts
function install_bootloaders
{
    # If there is a `/boot/kernelsetup.sh`, do that and nothing else.
    if [[ -f /boot/kernelsetup.sh ]]; then
        pushd /boot >/dev/null
        ./kernelsetup.sh
        popd >/dev/null
        return
    fi

    if [[ ! "${no_bootloaders:-}" ]]
    then
        typeset ident
        ident=$(steamos-bootconf this-image)
        # fallback if there are no bootconfs in /esp, so we can't determine our image name
        if [[ -z ${ident} ]]
        then
            rootdsk=$(findmnt --noheadings -o PARTLABEL / )
            ident=${rootdsk#rootfs-}
        fi

        if [[ -z ${ident} ]]
        then
            echo "Failed to determine new boot identifier"
            exit 1
        fi

        steamcl-install
        if mountpoint -q /boot
        then
            grub-install
        else
            echo "Warning: Skipping installation artifacts to /boot!" >&2
            grub-mkimage
        fi

        if [[ ! -e /efi/@steamos_relpath@ ]]
        then
            mkdir -p /efi/@steamos_relpath@
        fi

        if [[ ! -e /esp/@bootconf_reldir@/${ident}.conf ]]
        then
            echo "Initializing boot configuration at /esp/@bootconf_reldir@ for ${ident}"
            mkdir -p /esp/@bootconf_reldir@
            steamos-bootconf --conf-dir /esp/@bootconf_reldir@ create --image ${ident}
        fi

        # we want to know our buildid
        . /etc/os-release ||:
        # mostly just a nice-to-have, but it also resolves a condition where an empty conf doesn't get updated
        steamos-bootconf --conf-dir /esp/@bootconf_reldir@ config --image ${ident} --set comment "${BUILD_ID:-}"
    fi

    if [[ ! "${no_kernel:-}" ]]
    then
        echo "Runnign ${0##*/} without --no-kernel is not supported"
        exit 1
    fi
    if [[ "${roothash:-}" ]]
    then
        mkdir -p /efi/SteamOS
        echo "$roothash" >/efi/@roothash_relpath@
    fi
    mapfile -t linux < <(ls -1 /boot/vmlinuz-* 2>/dev/null)
    if [[ "${#linux[*]}" -eq 0 ]]
    then
        echo "Warning: /boot: No such vmlinuz!" >&2
    fi
    mapfile -t initramfs < <(ls -1 /boot/initramfs-*.img 2>/dev/null)
    if [[ "${#initramfs[*]}" -eq 0 ]]
    then
        echo "Warning: /boot: No such initramfs!" >&2
    fi
    mapfile -t modules < <(ls -d1 /usr/lib/modules/* 2>/dev/null)
    if [[ "${#modules[*]}" -eq 0 ]]
    then
        echo "Warning: /usr/lib/modules: No such modules!" >&2
    fi
    update-grub
}

function in_chroot
{
    local proc_root;
    local root;
    if ! proc_root="$(stat --printf "%d %i" /proc/1/root/ 2>/dev/null)" || ! root="$(stat --printf "%d %i" / 2>/dev/null)"; then
        return 1;
    fi;
    test "$proc_root" != "$root"
}

# Migrate configuration before booting new image.
# Currently:
#   Convert wifi system connections to a form that iwd can handle
#
function migrate_network
{
    # remove properties used by NetworkManager that are not permitted by iwd:
    local nm_dir=/var/lib/overlays/etc/upper/NetworkManager/system-connections
    test -d "$nm_dir" && find "$nm_dir" -type f -name \*.nmconnection -print0 | while read -r -d $'\0' file;
    do
        if grep -q '^type=wifi' "$file"
        then
            sed -i 's/^\(mac-address\|interface-name\|permissions\|bssid\)=.*//' "$file" ||:
        fi
    done

    # when converting from early OS builds, we may not have masked out NetworkManager ephemeral files
    rm -f /var/lib/NetworkManager/*
}

function migrate_home_steamos_update
{
    # These have been disabled during the product launch and removed sometime
    # after. Remove the files from the user homedir.
    rm -f "/home/deck/.config/autostart/steamos-update-os-notifier.desktop" || :
    rm -f "/home/deck/.config/kupdatenotifierrc" || :

    # Migrate users from old usernames to new `steamos` user.
    NEW_USERNAME="steamos"
    # Collect old user name by entering PID 1's mount namespace and getting the UID of 1000
    OLD_USERNAME="$(nsenter -t 1 -m id -u -n 1000)"

    # Only attempt migration if we got a 1000 uid username at all.  If we didn't..... good luck, my dude.
    if [[ -n "${OLD_USERNAME}" ]]; then
        # Only atempt migration if there's a mismatch in username
        if [[ "${OLD_USERNAME}" != "${NEW_USERNAME}" ]]; then
            echo "migrate_home_steamos_update: Migrating user from ${OLD_USERNAME} -> ${NEW_USERNAME}"

            # We only modify files left in the `etc` overlay upperdir
            # We must do this file-by-file `sed` operation because the user may have only
            # modified a single file (e.g. `shadow` by changing their password, or perhaps
            # `group` by adding a new group), thereby creating a mismatch between `passwd`
            # and `shadow`.  This tends to cause issues when using tools like `usermod`
            # to do the renaming, so we resort to `sed`.

            for USER_DB in passwd gshadow shadow group subuid subgid; do
                USER_DB="/var/lib/overlays/etc/upper/${USER_DB}"
                if [[ ! -f "${USER_DB}" ]]; then
                    continue
                fi

                # Map the following fields in any of these databases:
                SED_OPTIONS=(
                    # in-place editing
                    -i

                    # This matches an element in a database, delimited by beginning/end of line,
                    # colon for database keys, or comma (for group lists).
                    -E
                    -e "s&(^|:|,)${OLD_USERNAME}(\$|:|,)&\1${NEW_USERNAME}\2&"

                    # This matches a home entry, e.g. `:/home/steamvr:`
                    -e "s&:/home/${OLD_USERNAME}:&:/home/${NEW_USERNAME}:&"
                )

                sed "${SED_OPTIONS[@]}" "${USER_DB}"
            done
        else
            echo "migrate_home_steamos_update: User is already ${NEW_USERNAME}, taking no further action"
        fi
    else
        echo "migrate_home_steamos_update: No uid 1000 user found?"
    fi
}

function update_pacman_dbpath
{
    local pacman_conf="/var/lib/overlays/etc/upper/pacman.conf"
    if [[ ! -f "$pacman_conf" ]]; then
        return 0
    fi

    # DBPath is on the RO rootfs with 3.5+
    local -i path_ok=1
    grep -q "^DBPath = /usr/lib/holo/pacmandb/$" "$pacman_conf" || path_ok=0
    if (( ! path_ok )); then
        sed -i "s|^#*DBPath.*$|DBPath = /usr/lib/holo/pacmandb/|" "$pacman_conf" || :
    fi
}

function cleanup_atomupd_conf
{
    # When updating from SteamOS 3.5 and earlier, we usually preserved /etc/ user edits.
    # This could be problematic for atomupd, because older configurations could miss new
    # required fields.
    # Force the removal of the eventual user edited `client.conf`.
    rm -f "/var/lib/overlays/etc/upper/steamos-atomupd/client.conf"
}

while [[ "$#" -ne 0 ]]
do
    if [[ "$1" =~ ^(-h|--help)$ ]]
    then
        usage
        exit
    elif [[ "$1" =~ ^(--roothash)$ ]]
    then
        shift
        roothash="$1"
    elif [[ "$1" =~ ^(--no-bootloaders)$ ]]
    then
        no_bootloaders=1
    elif [[ "$1" =~ ^(--no-kernel)$ ]]
    then
        no_kernel=1
    elif [[ "$1" =~ ^(--no-boot-install)$ ]]
    then
        no_boot_install=1
    elif [[ "$1" =~ ^(--no-migrate)$ ]]
    then
        no_migrate=1
    elif [[ "$1" =~ ^(-f|--force)$ ]]
    then
        force_migrate=1
    else
        usage
        echo "$1: Too many arguments" >&2
        exit 1
    fi
    shift
done

if [[ ! ${no_migrate:-} ]]
then
    if in_chroot || [[ ${force_migrate:-} ]]
    then
        migrate_network
        migrate_home_steamos_update
        update_pacman_dbpath # DBPath is on the RO rootfs with 3.5+
        cleanup_atomupd_conf

        # If the recorded variant is `vr-goldmaster`, clear all atomupd preferences
        # We can remove this once we have actually EOL'ed `vr-goldmaster` -> `vr`,
        # which should happen pre-launch day.
        ATOMUPD_PREFS="/var/lib/overlays/etc/upper/steamos-atomupd/preferences.conf"
        if grep -q "Variant=vr-goldmaster" "${ATOMUPD_PREFS}"; then
            rm -f "${ATOMUPD_PREFS}"
        fi
    else
        echo "Skipping configuration migration steps as this is not running in a chroot."
    fi
fi

if [[ ! ${no_boot_install:-} ]]
then
    install_bootloaders
fi

if in_chroot
then
    # Trigger steamos-post-update.service on the next boot.
    # The directory `/var/lib/steamos-atomupd` should have been created by post-install.sh already,
    # but if the starting image is too old, that could not be the case.
    mkdir -p /var/lib/steamos-atomupd || \
        echo "Warning: Failed to create the directory /var/lib/steamos-atomupd" >&2
    touch /var/lib/steamos-atomupd/system-updated || \
        echo "Warning: Failed to create the trigger file /var/lib/steamos-atomupd/system-updated. steamos-post-update.service may not run on first boot." >&2
fi
